#!/usr/bin/env bash
# Cliente de la API biblioteca/v1 (plugin "Biblioteca Depura").
# Config: BD_URL y BD_TOKEN en el entorno, en el config de la skill, en ~/.config/biblioteca-depura/config
# o, si no hay nada de eso, en el bloque "Conexión" del SKILL.md (la conexión viaja con la skill).
#   bd indice [component|handbook] [texto]   → catálogo compacto (JSON)
#   bd entrada ID [html]                       → entrada completa; "html" agrega contenido_html para editar
#   bd taxonomias                              → términos existentes (stack, clase, proyecto)
#   bd url URL                                 → todas las entradas del archivo de un proyecto, stack o clase (o la entrada, si es su URL)
#   bd proponer ARCHIVO.json                   → crea propuesta; devuelve link de aprobación
#   bd estado ID_PROPUESTA                     → pendiente | aprobada | rechazada | vencida | error
set -euo pipefail
# Primero el config dentro de la skill (gitignored); si no existe, el de ~/.config
CONF="$(dirname "$(readlink -f "$0")")/../config"
[ -f "$CONF" ] || CONF="${XDG_CONFIG_HOME:-$HOME/.config}/biblioteca-depura/config"
# El entorno tiene prioridad sobre el archivo (ej. BD_URL=https://sitio-local para probar en local)
ENV_URL="${BD_URL:-}" ENV_TOKEN="${BD_TOKEN:-}"
[ -f "$CONF" ] && . "$CONF"
# Sin config: la conexión incluida en el SKILL.md de esta skill (bloque "Conexión").
SKILL_MD="$(dirname "$(readlink -f "$0")")/../SKILL.md"
if [ -z "${BD_TOKEN:-}" ] && [ -f "$SKILL_MD" ]; then
  BD_URL="${BD_URL:-$(grep -m1 -oP '^BD_URL=\K\S+' "$SKILL_MD" || true)}"
  BD_TOKEN="$(grep -m1 -oP '^BD_TOKEN=\K\S+' "$SKILL_MD" || true)"
fi
BD_URL="${ENV_URL:-${BD_URL:-}}" BD_TOKEN="${ENV_TOKEN:-${BD_TOKEN:-}}"
: "${BD_URL:?Falta BD_URL (ver $CONF)}" "${BD_TOKEN:?Falta BD_TOKEN (ver $CONF)}"
API="${BD_URL%/}/wp-json/biblioteca/v1"
get() { curl -sS --fail-with-body -H "X-Biblioteca-Token: $BD_TOKEN" "$API/$1"; }

case "${1:-}" in
  indice)     get "indice?tipo=${2:-}&q=$(jq -rn --arg q "${3:-}" '$q|@uri')" ;;
  entrada)    get "entrada/${2:?ID}${3:+?html=1}" ;;
  taxonomias) get taxonomias ;;
  url)        # Solo viaja la ruta: una URL completa en la query la puede frenar el firewall del hosting
              ruta="${2:?URL}"; ruta="${ruta#*://}"; get "url?ruta=$(jq -rn --arg q "/${ruta#*/}" '$q|@uri')" ;;
  proponer)   # Adjuntos con "archivo": "/ruta/local" se convierten a base64 (y toman el nombre del archivo si falta)
              body=$(mktemp); cp "${2:?archivo JSON}" "$body"
              for i in $(jq -r '.datos.adjuntos // [] | to_entries[] | select(.value.archivo) | .key' "$body"); do
                src=$(jq -r ".datos.adjuntos[$i].archivo" "$body"); b64=$(mktemp); base64 -w0 "$src" > "$b64"
                jq --argjson i "$i" --rawfile b "$b64" --arg n "$(basename "$src")" \
                  '.datos.adjuntos[$i] |= ((.nombre //= $n) | del(.archivo) | .base64 = $b)' "$body" > "$body.tmp" && mv "$body.tmp" "$body"
                rm -f "$b64"
              done
              curl -sS --fail-with-body -X POST -H "X-Biblioteca-Token: $BD_TOKEN" -H 'Content-Type: application/json' \
                --data-binary "@$body" "$API/propuestas"; rm -f "$body" ;;
  estado)     get "propuestas/${2:?ID de propuesta}" ;;
  *) sed -n '2,10p' "$0"; exit 1 ;;
esac
echo
